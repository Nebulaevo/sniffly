{
    "compilerOptions": {
        
        /* Base Options */
        "esModuleInterop": true,
        "skipLibCheck": true,
        "target": "ES2020",
        "verbatimModuleSyntax": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "moduleDetection": "force",

        /* Strictness */
        "strict": true,
        "noUncheckedIndexedAccess": true, /* for unsafe indexing */
        
        /* Because transpiling with typescript */
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "outDir": "dist",
        "sourceMap": true,

        /* Because library */
        "declaration": true,
        "declarationMap": true,
        
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}